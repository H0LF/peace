# PEACE's own speech service on 127.0.0.1:3900 (Whisper and Piper, on the CPU). Needs: uv sync --extra voice
[Unit]
Description=PEACE speech service (hears and speaks, on the CPU)
StartLimitIntervalSec=300
StartLimitBurst=3
ConditionPathExists=%h/peace/.venv/bin/peace-voice

[Service]
WorkingDirectory=%h/peace
ExecStart=%h/peace/.venv/bin/peace-voice
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
